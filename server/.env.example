# 复制成 .env 再改：cp .env.example .env。不填的项对应的功能不可用，其余照常。

# 注册邀请码：注册账号时要填（客户端「注册」里的邀请码）。不填就谁也注册不了
BEAYY_INVITE=EXAMPLE-INVITE-CHANGE-ME-2026

# 转写、地图票据的签名密钥。不填会自动生成一个存在 data/sync/ticket_secret
# 自己生成：openssl rand -hex 32
BEAYY_TICKET_SECRET=

# 这台服务对外的地址，如 https://sync.example.com。不填按请求的地址算，一般不用填
BEAYY_OFFICIAL_HOST=

# ---- 官方服务（可选）：服务器替开通了的账号调模型、地图，客户端不用自己填 Key。账号要先开通：
#      docker compose exec -u beayy beayy-server python admin.py open <邮箱>

# 模型：任何 OpenAI 兼容接口，如 https://api.openai.com/v1
BEAYY_LLM_GATEWAY=
BEAYY_LLM_KEY=
BEAYY_LLM_MODEL=

# 高德地图：Web 服务 Key（地名、附近的店、静态图）
BEAYY_AMAP_KEY=
# 高德地图：Web 端（JS API）Key 和安全密钥（能缩放的地图）
BEAYY_AMAP_JS_KEY=
BEAYY_AMAP_JS_CODE=

# ---- 转写（--profile asr 才用）
# 人名、项目名这类容易认错的专名，空格分隔
BEAYY_HOTWORDS=
# 转写用几个 CPU 线程
BEAYY_ASR_THREADS=4
# 认人的门槛（余弦相似度）：和本人声纹 ≥ 这个算本人；和当天的他人 ≥ 这个算同一个人
BEAYY_SELF_TH=0.55
BEAYY_OTHER_TH=0.60

# ---- 端口和入口
# 监听哪个地址：127.0.0.1 只给本机（前面有反向代理时）；0.0.0.0 让局域网、Tailscale 里的设备直连
BEAYY_BIND=127.0.0.1
BEAYY_PORT=8770
# --profile caddy：解析到这台机器的域名，Caddy 自动申请 HTTPS 证书
BEAYY_DOMAIN=
# --profile tunnel：Cloudflare Zero Trust → Tunnels 建隧道拿到的令牌；隧道的 Public Hostname 指向 http://beayy-server:8770
CLOUDFLARE_TUNNEL_TOKEN=
